# Copy this file to .env for local development.
# Do not commit the real .env file.

GITHUB_USERNAME=RR0327

# Optional. The system works with public data when this is empty.
# Add a fine-grained token for a higher rate limit or permitted private data.
GITHUB_TOKEN=

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_CONTRIBUTIONS_URL="https://github.com/users/{username}/contributions?from={from_date}&to={to_date}"
GITHUB_TIMEZONE=Asia/Dhaka

PRIMARY_STATS_URL="https://github-readme-stats.vercel.app/api?username={username}&show_icons=true&rank_icon=github&include_all_commits=true&count_private=true&cache_seconds=1800"
PRIMARY_STREAK_URL="https://streak-stats.demolab.com?user={username}&disable_animations=true"
PRIMARY_LANGUAGES_URL="https://github-readme-stats.vercel.app/api/top-langs/?username={username}&layout=compact&cache_seconds=1800"

PRIMARY_TIMEOUT_SECONDS=7
BACKUP_TIMEOUT_SECONDS=15
MAX_IMAGE_BYTES=2000000
MAX_REPOSITORIES=50
LANGUAGE_CONCURRENCY=8
INCLUDE_FORKS=false
STREAK_LOOKBACK_DAYS=400
LIVE_DATA_CACHE_SECONDS=900

SUCCESS_CACHE_SECONDS=1800
SNAPSHOT_CACHE_SECONDS=21600
STALE_WHILE_REVALIDATE_SECONDS=86400

FALLBACK_DIRECTORY=assets/fallback
USER_AGENT=RR0327-GitHub-Stats-Failover/3.0
LOG_LEVEL=INFO
